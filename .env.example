# --- Database (§3 data model) ---
DATABASE_URL=postgresql+psycopg://groundline:groundline@localhost:5432/groundline

# --- Object storage for version snapshots (§6) ---
# S3-compatible; local dev uses MinIO from infra/docker-compose.yml
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=groundline
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- Entra ID / OIDC SSO (§5, GL-3-11/GL-3-12) ---
# Off by default; dev login keeps working alongside SSO when enabled.
AUTH_SSO_ENABLED=false
# Empty -> derived from ENTRA_TENANT_ID (real Entra). MOCK-ONLY value for the
# `sso-mock` compose profile: http://mock-oidc.localhost:8090/entra/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
ENTRA_TENANT_ID=
# MOCK-ONLY values for the sso-mock profile: groundline-local / mock-secret
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Goes through the web origin (Vite dev proxy), so the post-login redirect to
# `/` lands in the web app.
OIDC_REDIRECT_URI=http://localhost:5173/v1/auth/sso/callback
# Comma-separated scopes; the groups claim is configured on the app
# registration (token configuration), not requested as a scope.
OIDC_SCOPES=openid,profile,email
# JSON: Entra group OBJECT ID (GUID) -> admin|editor|annotator|viewer, plus
# "default". Highest-privilege match wins. Mock fixture IDs: see
# infra/docker-compose.yml and infra/mock-oidc/fixture-users.json.
ROLE_MAPPING={"default":"viewer"}

# --- Personal access tokens (§5 machine access) ---
PAT_DEFAULT_TTL_DAYS=90

# --- App ---
APP_SECRET_KEY=change-me
